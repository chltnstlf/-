name: Weekly Economic Calendar Bot

on:
  schedule:
    # UTC 기준 매주 월요일 00:00 (한국시간 월요일 오전 09:00)
    - cron: '0 0 * * 1'
  workflow_dispatch: # 필요 시 깃허브에서 버튼 눌러 즉시 실행 가능

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v3

      - name: Python 설정
        uses: actions/setup-python@v4
        with:
          python-version: '3.10'

      - name: 라이브러리 설치
        run: pip install requests

      - name: 스크립트 실행
        env:
          TELEGRAM_BOT_TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}
          TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}
        run: python 매주_월_고영향지표.py
